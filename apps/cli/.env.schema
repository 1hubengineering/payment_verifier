# @generateTsTypes(path=./env.ts, exposeEnv=local)
# ---

# Maximum provider retrieval time.
# @type=number(min=1, max=60000, isInt=true) @sensitive=false
RECEIPT_TIMEOUT_MS=15000

# Optional absolute SQLite path; default is .receipt-state-v2.sqlite at workspace root.
# @type=string @required=false @sensitive=true
RECEIPT_DATABASE_FILE=

# 64 hexadecimal characters encoding a random 32-byte key; required for queue commands.
# @type=string @required=false @sensitive=true
RECEIPT_JOB_KEY=

# Explicit operator opt-in. Routine development keeps provider traffic disabled.
# @type=boolean @sensitive=false
RECEIPT_ALLOW_PROVIDER_TRAFFIC=false

# Also requires matching Chromium and traffic opt-in.
# @type=boolean @sensitive=false
RECEIPT_ENABLE_CBE=false
