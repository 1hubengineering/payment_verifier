{
  "name": "@1hubengineering/adapter-drizzle",
  "version": "0.1.1",
  "private": false,
  "description": "Versioned Drizzle storage integration for receipt-only verification",
  "homepage": "https://github.com/1hubengineering/payment_verifier/tree/main/packages/receipt-verifier-adapter-drizzle",
  "bugs": {
    "url": "https://github.com/1hubengineering/payment_verifier/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1hubengineering/payment_verifier.git",
    "directory": "packages/receipt-verifier-adapter-drizzle"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "import": "./dist/postgres.mjs"
    },
    "./mysql": {
      "types": "./dist/mysql.d.mts",
      "import": "./dist/mysql.mjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.mts",
      "import": "./dist/sqlite.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "check:package": "publint --strict",
    "check:kit": "node ../../scripts/check-drizzle-kit.mjs"
  },
  "dependencies": {
    "@1hubengineering/verifier": "workspace:*"
  },
  "devDependencies": {
    "@libsql/client": "0.17.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "rc",
    "drizzle-orm": "rc",
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  },
  "peerDependencies": {
    "@libsql/client": "0.17.4",
    "drizzle-orm": ">=1.0.0-rc <1.0.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  }
}
