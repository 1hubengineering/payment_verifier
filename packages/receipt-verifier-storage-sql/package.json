{
  "name": "@1hubengineering/receipt-verifier-storage-sql",
  "version": "0.0.0",
  "private": true,
  "description": "Atomic receipt verification storage for selected SQL clients",
  "license": "ISC",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "import": "./dist/postgres.mjs"
    },
    "./mysql": {
      "types": "./dist/mysql.d.mts",
      "import": "./dist/mysql.mjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.mts",
      "import": "./dist/sqlite.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check:package": "publint --strict"
  },
  "dependencies": {
    "@1hubengineering/receipt-verifier": "workspace:*",
    "kysely": "0.29.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.23.1",
    "better-sqlite3": "13.2.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  },
  "peerDependencies": {
    "better-sqlite3": "13.2.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  }
}
